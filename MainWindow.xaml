<Window x:Class="DesktopNote.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="时笺"
        Width="348" Height="600"
        MinWidth="270" MinHeight="240"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ShowActivated="False"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        FontFamily="Microsoft YaHei UI, Segoe UI"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Ideal">

    <Window.Resources>

        <LinearGradientBrush x:Key="TintGlass" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#C6141A24" Offset="0" />
            <GradientStop Color="#CD0B0F15" Offset="0.55" />
            <GradientStop Color="#D4070A0F" Offset="1" />
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="TintSolid" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#F5131922" Offset="0" />
            <GradientStop Color="#F90B0F15" Offset="1" />
        </LinearGradientBrush>

        <!-- 图标按钮 -->
        <Style x:Key="IconBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="#7E8A9C" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="Transparent" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#1FFFFFFF" />
                                <Setter Property="Foreground" Value="#DCE5F2" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#33FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 文字按钮 -->
        <Style x:Key="GhostBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="#8B96A8" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Padding" Value="6,3" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="Transparent" CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#14FFFFFF" />
                                <Setter Property="Foreground" Value="#DCE5F2" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FlatBox" TargetType="TextBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="#E9EEF6" />
            <Setter Property="CaretBrush" Value="#6AA6FF" />
            <Setter Property="SelectionBrush" Value="#4A6AA6FF" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 细滚动条 -->
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="5" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False" />
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Background="#38FFFFFF" CornerRadius="3" Margin="1,0" />
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False" />
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <Grid x:Name="RootGrid" Margin="15">
        <Border x:Name="Shell" CornerRadius="18" BorderThickness="1" BorderBrush="#20FFFFFF">
            <Border.Effect>
                <DropShadowEffect BlurRadius="26" ShadowDepth="5" Direction="270" Opacity="0.5" Color="#000000" />
            </Border.Effect>

            <Grid>
                <Border x:Name="WallpaperLayer" CornerRadius="17" />

                <Border x:Name="TintLayer" CornerRadius="17" Background="{StaticResource TintGlass}" />

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- 顶部：日期块 + 标题 + 操作 -->
                    <Grid Grid.Row="0" x:Name="HeaderArea" Margin="14,13,10,10" Background="Transparent"
                          MouseLeftButtonDown="Header_MouseLeftButtonDown"
                          MouseMove="Header_MouseMove"
                          MouseLeftButtonUp="Header_MouseLeftButtonUp"
                          LostMouseCapture="Header_LostMouseCapture">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Width="44" Height="44" CornerRadius="11"
                                Background="#16FFFFFF" BorderBrush="#22FFFFFF" BorderThickness="1">
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                <TextBlock x:Name="MonthText" Text="11月" FontSize="9" Foreground="#93A0B4"
                                           HorizontalAlignment="Center" Margin="0,0,0,1" />
                                <TextBlock x:Name="DayText" Text="13" FontSize="17" FontWeight="SemiBold"
                                           Foreground="#E9EEF6" HorizontalAlignment="Center" LineHeight="18" />
                            </StackPanel>
                        </Border>

                        <StackPanel Grid.Column="1" Margin="11,0,8,0" VerticalAlignment="Center">
                            <TextBlock Text="未来日程" FontSize="13.5" FontWeight="SemiBold" Foreground="#E9EEF6" />
                            <TextBlock x:Name="SubTitle" Text="空闲" FontSize="10.5" Foreground="#7E8A9C"
                                       Margin="0,3,0,0" />
                        </StackPanel>

                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top" Margin="0,-2,-2,0">
                            <Button x:Name="HideBtn" Style="{StaticResource IconBtn}" Width="24" Height="24"
                                    Content="&#xE921;" ToolTip="收起到托盘" Click="HideBtn_Click" />
                        </StackPanel>
                    </Grid>

                    <!-- 快速添加 -->
                    <Border Grid.Row="1" Margin="12,0,12,6" Height="36" CornerRadius="10"
                            Background="#14FFFFFF" BorderBrush="#1CFFFFFF" BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="&#xE710;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                       FontSize="12" Foreground="#6E7B8E" VerticalAlignment="Center" Margin="11,0,9,0" />
                            <Grid Grid.Column="1">
                                <TextBox x:Name="AddBox" Style="{StaticResource FlatBox}" Margin="0,0,10,0"
                                         KeyDown="AddBox_KeyDown" TextChanged="AddBox_TextChanged"
                                         VerticalAlignment="Center" />
                                <TextBlock x:Name="AddHint" Text="明天 9:30 交周报" FontSize="12.5" Foreground="#5A6474"
                                           VerticalAlignment="Center" Margin="0,0,10,0" IsHitTestVisible="False" />
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- 列表 -->
                    <ScrollViewer Grid.Row="2" x:Name="Scroller" VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled" Margin="6,0,2,0"
                                  PanningMode="VerticalOnly">
                        <StackPanel x:Name="ListHost" Margin="6,0,6,0" />
                    </ScrollViewer>

                    <!-- 空状态 -->
                    <StackPanel x:Name="EmptyState" Grid.Row="2" VerticalAlignment="Center"
                                HorizontalAlignment="Center" Visibility="Collapsed" Margin="0,0,0,34">
                        <TextBlock Text="&#xE8FD;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                   FontSize="22" Foreground="#3C4655" HorizontalAlignment="Center" />
                        <TextBlock Text="还没有安排" FontSize="11.5" Foreground="#6C7787"
                                   HorizontalAlignment="Center" Margin="0,10,0,0" />
                        <TextBlock Text="在上面输入「明天 9:30 交周报」试试" FontSize="10.5" Foreground="#4E5867"
                                   HorizontalAlignment="Center" Margin="0,5,0,0" />
                    </StackPanel>

                    <!-- 底部 -->
                    <Border Grid.Row="3" BorderBrush="#14FFFFFF" BorderThickness="0,1,0,0" Margin="12,6,12,0">
                        <Grid Margin="0,5,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Button x:Name="DoneToggle" Grid.Column="0" Style="{StaticResource GhostBtn}"
                                    Content="已完成" Click="DoneToggle_Click" HorizontalAlignment="Left" />
                            <TextBlock x:Name="FooterStat" Grid.Column="2" Text="" FontSize="10.5"
                                       Foreground="#5F6A79" VerticalAlignment="Center" Margin="0,0,14,0" />
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Border>

        <!-- 缩放手柄 -->
        <Border x:Name="Grip" Width="18" Height="18" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                Background="Transparent" Cursor="SizeNWSE" Margin="0,0,2,2"
                MouseLeftButtonDown="Grip_MouseLeftButtonDown"
                MouseMove="Grip_MouseMove"
                MouseLeftButtonUp="Grip_MouseLeftButtonUp"
                LostMouseCapture="Grip_LostMouseCapture">
            <Path Stroke="#40FFFFFF" StrokeThickness="1.2" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                  Margin="0,0,4,4">
                <Path.Data>
                    <GeometryGroup>
                        <LineGeometry StartPoint="10,0" EndPoint="0,10" />
                        <LineGeometry StartPoint="10,5" EndPoint="5,10" />
                    </GeometryGroup>
                </Path.Data>
            </Path>
        </Border>
    </Grid>
</Window>
