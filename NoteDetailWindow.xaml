<Window x:Class="DesktopNote.NoteDetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="时笺 - 详情"
        Width="340" Height="420"
        MinWidth="260" MinHeight="260"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        FontFamily="Microsoft YaHei UI, Segoe UI"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Ideal"
        Deactivated="Window_Deactivated">

    <Window.Resources>
        <Style x:Key="FlatBox" TargetType="TextBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="#E9EEF6" />
            <Setter Property="CaretBrush" Value="#6AA6FF" />
            <Setter Property="SelectionBrush" Value="#446AA6FF" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <ScrollViewer x:Name="PART_ContentHost" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GhostBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="FontFamily" Value="Microsoft YaHei UI, Segoe UI" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#18FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#28FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- 毛玻璃底层（Backdrop 由 code-behind 通过 Win32 设置） -->
    <Border x:Name="Root" CornerRadius="16" ClipToBounds="True">
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#D8141A24" Offset="0" />
                <GradientStop Color="#E00B0F15" Offset="1" />
            </LinearGradientBrush>
        </Border.Background>
        <Border BorderBrush="#22FFFFFF" BorderThickness="1" CornerRadius="16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- 标题栏（可拖动） -->
                <Grid Grid.Row="0" Margin="16,14,12,0"
                      MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock x:Name="TitleText"
                                   FontSize="14" FontWeight="SemiBold"
                                   Foreground="#E9EEF6"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="TimeText"
                                   FontSize="10.5" Foreground="#6AA6FF"
                                   Margin="0,3,0,0" />
                    </StackPanel>

                    <Button Grid.Column="1" x:Name="CloseBtn"
                            Width="26" Height="26"
                            Background="Transparent"
                            BorderThickness="0"
                            Cursor="Hand"
                            VerticalAlignment="Top"
                            Margin="0,-2,0,0"
                            Click="CloseBtn_Click"
                            FocusVisualStyle="{x:Null}"
                            ToolTip="关闭">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}"
                                        CornerRadius="8" Width="26" Height="26">
                                    <TextBlock Text="&#xE8BB;"
                                               FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                               FontSize="10" Foreground="#8B96A8"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#20FFFFFF" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>

                <!-- 分隔线 -->
                <Border Grid.Row="1" Height="1" Background="#18FFFFFF" Margin="16,10,16,0" />

                <!-- 备注输入区 -->
                <Grid Grid.Row="2" Margin="16,12,16,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- 标签行 -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,6">
                        <TextBlock Text="&#xE70B;"
                                   FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                   FontSize="10" Foreground="#6E7B8E"
                                   VerticalAlignment="Center"
                                   Margin="0,0,6,0" />
                        <TextBlock Text="备注" FontSize="10.5" Foreground="#6E7B8E"
                                   VerticalAlignment="Center" />
                        <TextBlock x:Name="SavedHint" Text="已保存" FontSize="9.5"
                                   Foreground="#4A6AA6FF" Margin="8,0,0,0"
                                   VerticalAlignment="Center" Opacity="0" />
                    </StackPanel>

                    <!-- 备注文本框容器 -->
                    <Border Grid.Row="1"
                            Background="#12FFFFFF"
                            BorderBrush="#18FFFFFF"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="10,8">
                        <TextBox x:Name="NotesBox"
                                 Style="{StaticResource FlatBox}"
                                 FontSize="12"
                                 Foreground="#C8D4E6"
                                 TextWrapping="Wrap"
                                 AcceptsReturn="True"
                                 VerticalScrollBarVisibility="Auto"
                                 TextChanged="NotesBox_TextChanged"
                                 VerticalAlignment="Stretch" />
                    </Border>
                </Grid>

                <!-- 底栏：占位文字 + 关闭按钮 -->
                <Grid Grid.Row="3" Margin="16,10,16,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Text="单击空白处或关闭窗口自动保存"
                               FontSize="9.5" Foreground="#3E4E63"
                               VerticalAlignment="Center" />

                    <Button Grid.Column="1"
                            Style="{StaticResource GhostBtn}"
                            x:Name="DoneBtn"
                            Content="完成"
                            Foreground="#6AA6FF"
                            Click="CloseBtn_Click" />
                </Grid>
            </Grid>
        </Border>
    </Border>
</Window>
